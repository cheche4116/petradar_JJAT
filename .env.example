PORT=3000

# Database Configuration
# Use DATABASE_URL in managed database providers.
# DATABASE_URL=postgresql://user:password@host:5432/petradar
# DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=petradar
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

# Redis Configuration (para caché)
# Leave REDIS_HOST empty to use in-memory cache.
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=600

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_user
SMTP_PASS=your_password
SMTP_FROM=no-reply@petradar.local
GENERIC_NOTIFICATION_EMAIL=alertas@petradar.local

# Azure Application Insights (opcional)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

